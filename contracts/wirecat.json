{
  "wcat_manifest": 2,
  "name": "notion",
  "description": "Notion pages and databases for you and your agent, read live with your own token",
  "docs_url": "https://github.com/WireCatLabs/notion-cli#readme",
  "package": "@wirecat/notion-cli",
  "bin": "wcat-notion",
  "commands": [
    {
      "path": [
        "commands"
      ],
      "summary": "every command by section; --json prints its contract, one path per call",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "commands",
        "info"
      ],
      "summary": "one command contract, or all schemas, error reasons and explicit overrides",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "session",
        "start"
      ],
      "summary": "sign in to Notion with a personal access token or an internal connection's token",
      "effects": {
        "remote": "read",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "status"
      ],
      "summary": "show where this profile's token comes from; never the token",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "session",
        "end"
      ],
      "summary": "forget this profile's token on this computer",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "list"
      ],
      "summary": "list the profiles here and whether each is signed in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "account",
        "remove"
      ],
      "summary": "sign this profile out and forget it, keeping or deleting its data",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "account.remove",
      "entity": "account_removal"
    },
    {
      "path": [
        "folders",
        "add"
      ],
      "summary": "import a folder and everything under it on the next sync",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "folders.add"
    },
    {
      "path": [
        "folders",
        "list"
      ],
      "summary": "list the folder ids sync imports",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "folders.list",
      "entity": "selected_folder"
    },
    {
      "path": [
        "folders",
        "browse"
      ],
      "summary": "list Notion pages and databases one level at a time, live",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "folders.browse",
      "entity": "notion_folder"
    },
    {
      "path": [
        "folders",
        "remove"
      ],
      "summary": "stop importing a folder; the next sync drops its documents",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "folders.remove"
    },
    {
      "path": [
        "sync"
      ],
      "summary": "import what changed in the chosen folders, and finish an unfinished sync",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "sync"
    },
    {
      "path": [
        "status"
      ],
      "summary": "show the last sync, imported documents and pending work",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "status"
    },
    {
      "path": [
        "documents",
        "list"
      ],
      "summary": "list the synced pages and database rows with their Notion links",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "documents.list",
      "entity": "document"
    },
    {
      "path": [
        "documents",
        "show"
      ],
      "summary": "show an imported document's text, tabs and metadata",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "documents.show"
    },
    {
      "path": [
        "documents",
        "export"
      ],
      "summary": "write an imported document to a new Markdown file",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "documents.export"
    },
    {
      "path": [
        "documents",
        "context"
      ],
      "summary": "show a document with its tags, relationships, notes, memories and editors",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "documents.context"
    },
    {
      "path": [
        "documents",
        "get"
      ],
      "summary": "read one page live from Notion, as Markdown",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "documents.get",
      "entity": "document_markdown"
    },
    {
      "path": [
        "documents",
        "create"
      ],
      "summary": "create a Notion page under another page",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "documents.create"
    },
    {
      "path": [
        "documents",
        "update"
      ],
      "summary": "replace a Notion page's text",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "documents.update"
    },
    {
      "path": [
        "documents",
        "delete"
      ],
      "summary": "move a Notion page to the trash",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "documents.delete"
    },
    {
      "path": [
        "documents",
        "restore"
      ],
      "summary": "bring a Notion page back from the trash",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "documents.restore"
    },
    {
      "path": [
        "documents",
        "add"
      ],
      "summary": "keep one Notion page's text in memory, read live, without syncing a folder",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "documents.add"
    },
    {
      "path": [
        "search"
      ],
      "summary": "search imported documents by words, and by meaning when indexed",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "search"
    },
    {
      "path": [
        "catalog",
        "import"
      ],
      "summary": "put cached file and folder metadata into the shared database",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "catalog.import"
    },
    {
      "path": [
        "catalog",
        "show"
      ],
      "summary": "show stored metadata and the stable file or folder reference",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.show",
      "entity": "document"
    },
    {
      "path": [
        "catalog",
        "list"
      ],
      "summary": "list cached files and folders using metadata queries",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.list",
      "entity": "document"
    },
    {
      "path": [
        "catalog",
        "search"
      ],
      "summary": "search cached names, descriptions, types and observed people",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.search",
      "entity": "document"
    },
    {
      "path": [
        "catalog",
        "tree"
      ],
      "summary": "show the cached hierarchy below a folder or all selected roots",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.tree"
    },
    {
      "path": [
        "catalog",
        "tags",
        "list"
      ],
      "summary": "list local tags on a cached file or folder",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.tags.list",
      "entity": "document_tag"
    },
    {
      "path": [
        "catalog",
        "tags",
        "add"
      ],
      "summary": "add local tags on a cached file or folder",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "catalog.tags.add"
    },
    {
      "path": [
        "catalog",
        "tags",
        "remove"
      ],
      "summary": "remove local tags on a cached file or folder",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "catalog.tags.remove"
    },
    {
      "path": [
        "tags",
        "list"
      ],
      "summary": "list a document's tags",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "tags.list",
      "entity": "document_tag"
    },
    {
      "path": [
        "tags",
        "add"
      ],
      "summary": "tag a document",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "tags.add"
    },
    {
      "path": [
        "tags",
        "remove"
      ],
      "summary": "untag a document",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "tags.remove"
    },
    {
      "path": [
        "relationships",
        "list"
      ],
      "summary": "list a document's relationships",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "relationships.list",
      "entity": "document_relationship"
    },
    {
      "path": [
        "relationships",
        "add"
      ],
      "summary": "connect a document to another reference",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "relationships.add"
    },
    {
      "path": [
        "relationships",
        "remove"
      ],
      "summary": "remove one of a document's relationships",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "relationships.remove"
    },
    {
      "path": [
        "notes",
        "add"
      ],
      "summary": "write a note about a document",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "notes.add",
      "entity": "note"
    },
    {
      "path": [
        "notes",
        "list"
      ],
      "summary": "list a document's notes",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "notes.list",
      "entity": "note"
    },
    {
      "path": [
        "notes",
        "show"
      ],
      "summary": "show one note",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "notes.show",
      "entity": "note"
    },
    {
      "path": [
        "notes",
        "edit"
      ],
      "summary": "replace a note's text",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "notes.edit",
      "entity": "note"
    },
    {
      "path": [
        "notes",
        "remove"
      ],
      "summary": "delete one note",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "notes.remove"
    },
    {
      "path": [
        "memories",
        "add"
      ],
      "summary": "record a memory about a document",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "memories.add"
    },
    {
      "path": [
        "memories",
        "list"
      ],
      "summary": "list a document's memories",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "memories.list",
      "entity": "memory"
    },
    {
      "path": [
        "memories",
        "show"
      ],
      "summary": "show one memory",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "memories.show"
    },
    {
      "path": [
        "memories",
        "confirm"
      ],
      "summary": "confirm a proposed memory as true",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "memories.confirm"
    },
    {
      "path": [
        "memories",
        "stale"
      ],
      "summary": "mark a memory as out of date",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "memories.stale"
    },
    {
      "path": [
        "memories",
        "search"
      ],
      "summary": "search a document's memories by words",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "memories.search",
      "entity": "memory"
    },
    {
      "path": [
        "memories",
        "extract"
      ],
      "summary": "send a document's text to the model and show the memories it proposes",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "memories.extract"
    },
    {
      "path": [
        "facts",
        "add"
      ],
      "summary": "record a fact a document shows",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "facts.add"
    },
    {
      "path": [
        "facts",
        "list"
      ],
      "summary": "list a document's facts",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "facts.list",
      "entity": "fact"
    },
    {
      "path": [
        "facts",
        "show"
      ],
      "summary": "show one fact",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "facts.show"
    },
    {
      "path": [
        "facts",
        "confirm"
      ],
      "summary": "confirm a proposed fact; a decision it supersedes stops holding",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "facts.confirm"
    },
    {
      "path": [
        "facts",
        "reverse"
      ],
      "summary": "an accepted decision no longer holds, and nothing replaced it",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "facts.reverse"
    },
    {
      "path": [
        "identities",
        "list"
      ],
      "summary": "list the creator and last editor Notion shows for a page",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "identities.list",
      "entity": "document_identity"
    },
    {
      "path": [
        "identities",
        "link"
      ],
      "summary": "record that a Notion account belongs to a known person",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "identities.link"
    },
    {
      "path": [
        "databases",
        "list"
      ],
      "summary": "list the databases this token can see, live, one row per data source",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "databases.list",
      "entity": "database"
    },
    {
      "path": [
        "databases",
        "show"
      ],
      "summary": "show one database live: its data sources, their ids and properties",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "databases.show",
      "entity": "database"
    },
    {
      "path": [
        "comments",
        "list"
      ],
      "summary": "list the open comments on a Notion page or block, live",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "comments.list",
      "entity": "notion_comment"
    },
    {
      "path": [
        "comments",
        "create"
      ],
      "summary": "comment on a Notion page",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "comments.create"
    },
    {
      "path": [
        "comments",
        "reply"
      ],
      "summary": "reply in a Notion discussion",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "comments.reply"
    },
    {
      "path": [
        "files",
        "upload"
      ],
      "summary": "upload a file to the end of a Notion page",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.upload"
    },
    {
      "path": [
        "api",
        "list"
      ],
      "summary": "list every Notion API operation this CLI offers, without calling Notion",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "permission": "api.list",
      "entity": "api_operation"
    },
    {
      "path": [
        "api",
        "show"
      ],
      "summary": "show one operation's parameters and request schema, without calling Notion",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "permission": "api.show"
    },
    {
      "path": [
        "api",
        "get-self"
      ],
      "summary": "Retrieve your token's bot user — read (GET /v1/users/me)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.get-self"
    },
    {
      "path": [
        "api",
        "get-user"
      ],
      "summary": "Retrieve a user — read (GET /v1/users/{user_id})",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.get-user"
    },
    {
      "path": [
        "api",
        "get-users"
      ],
      "summary": "List all users — read (GET /v1/users)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.get-users"
    },
    {
      "path": [
        "api",
        "post-page"
      ],
      "summary": "Create a page — write (POST /v1/pages)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.post-page"
    },
    {
      "path": [
        "api",
        "retrieve-a-page"
      ],
      "summary": "Retrieve a page — read (GET /v1/pages/{page_id})",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.retrieve-a-page"
    },
    {
      "path": [
        "api",
        "patch-page"
      ],
      "summary": "Update page — write (PATCH /v1/pages/{page_id})",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.patch-page"
    },
    {
      "path": [
        "api",
        "move-page"
      ],
      "summary": "Move a page — write (POST /v1/pages/{page_id}/move)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.move-page"
    },
    {
      "path": [
        "api",
        "retrieve-a-page-property"
      ],
      "summary": "Retrieve a page property item — read (GET…",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.retrieve-a-page-property"
    },
    {
      "path": [
        "api",
        "retrieve-page-markdown"
      ],
      "summary": "Retrieve a page as markdown — read (GET /v1/pages/{page_id}/markdown)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.retrieve-page-markdown"
    },
    {
      "path": [
        "api",
        "update-page-markdown"
      ],
      "summary": "Update a page's content as markdown — write (PATCH /v1/pages/{page_id}/markdown)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.update-page-markdown"
    },
    {
      "path": [
        "api",
        "retrieve-async-task"
      ],
      "summary": "Retrieve an async task — read (GET /v1/async_tasks/{task_id})",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.retrieve-async-task"
    },
    {
      "path": [
        "api",
        "retrieve-a-block"
      ],
      "summary": "Retrieve a block — read (GET /v1/blocks/{block_id})",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.retrieve-a-block"
    },
    {
      "path": [
        "api",
        "update-a-block"
      ],
      "summary": "Update a block — write (PATCH /v1/blocks/{block_id})",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.update-a-block"
    },
    {
      "path": [
        "api",
        "delete-a-block"
      ],
      "summary": "Delete a block — destructive (DELETE /v1/blocks/{block_id})",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.delete-a-block"
    },
    {
      "path": [
        "api",
        "get-block-children"
      ],
      "summary": "Retrieve block children — read (GET /v1/blocks/{block_id}/children)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.get-block-children"
    },
    {
      "path": [
        "api",
        "patch-block-children"
      ],
      "summary": "Append block children — write (PATCH /v1/blocks/{block_id}/children)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.patch-block-children"
    },
    {
      "path": [
        "api",
        "retrieve-a-data-source"
      ],
      "summary": "Retrieve a data source — read (GET /v1/data_sources/{data_source_id})",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.retrieve-a-data-source"
    },
    {
      "path": [
        "api",
        "update-a-data-source"
      ],
      "summary": "Update a data source — write (PATCH /v1/data_sources/{data_source_id})",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.update-a-data-source"
    },
    {
      "path": [
        "api",
        "post-database-query"
      ],
      "summary": "Query a data source — read (POST /v1/data_sources/{data_source_id}/query)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.post-database-query"
    },
    {
      "path": [
        "api",
        "create-a-database"
      ],
      "summary": "Create a data source — write (POST /v1/data_sources)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.create-a-database"
    },
    {
      "path": [
        "api",
        "list-data-source-templates"
