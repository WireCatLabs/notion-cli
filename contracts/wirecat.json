  "desktop": {
    "tagline": "Notion pages and databases, searchable on your computer",
    "profiles": {
      "args": [
        "session",
        "list",
        "--no-record",
        "--json"
      ],
      "shape": "items"
    },
    "doctor": [
      "{profile}",
      "doctor",
      "--record",
      "--json"
    ],
    "runs": {
      "list": [
        "runs",
        "list",
        "{query}",
        "--limit",
        "{limit}",
        "--page",
        "{page}",
        "--no-record",
        "--json"
      ],
      "show": [
        "runs",
        "show",
        "{run}",
        "--no-record",
        "--json"
      ]
    },
    "search": null,
    "setup": [
      "{profile}",
      "session",
      "start"
    ],
    "signIn": {
      "gives": "Lets your agent read the Notion pages and databases your token can see.",
      "asks": "A Notion personal access token, or the token of an internal connection you made in Notion."
    },
    "skill": {
      "status": [
        "skill",
        "status",
        "--no-record",
        "--json"
      ],
      "install": [
        "skill",
        "install",
        "--for",
        "{target}",
        "--json"
      ],
      "show": [
        "skill",
        "show",
        "--no-record",
        "--json"
      ]
    },
    "mcpServer": {
      "start": [
        "mcp",
        "server",
        "start",
        "--port",
        "{port}",
        "--public-url",
        "{url}",
        "--profiles",
        "all",
        "--json"
      ],
      "stop": [
        "mcp",
        "server",
        "stop",
        "--profiles",
        "all",
        "--json"
      ],
      "status": [
        "mcp",
        "server",
        "status",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ],
      "revoke": [
        "mcp",
        "revoke",
        "--profiles",
        "all",
        "--json"
      ],
      "config": [
        "mcp",
        "config",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ]
    },
    "tasks": null,
    "sync": {
      "run": [
        "{profile}",
        "sync",
        "--record",
        "--json"
      ],
      "last": [
        "runs",
        "list",
        "command:sync",
        "status:success",
        "--limit",
        "50",
        "--no-record",
        "--json"
      ],
      "lastShape": "runs",
      "what": "Notion pages and database rows",
      "note": null
    },
    "storeInfo": null,
    "storeTables": null,
    "storeTableSizes": null,
    "storeCheck": null,
    "storeBackup": null,
    "storeBackupEncrypted": null,
    "storeResetPreview": null,
    "storeReset": null,
    "storage": {
      "app": "notion-cli",
      "env": "WCNOTION"
    },
    "settings": null,
    "accountRemove": {
      "signOut": [
        "{profile}",
        "session",
        "end",
        "--record",
        "--json"
      ],
      "remove": {
        "minVersion": "0.0.0",
        "keepData": [
          "{profile}",
          "account",
          "remove",
          "--keep-data",
          "--record",
          "--json"
        ],
        "deleteData": [
          "{profile}",
          "account",
          "remove",
          "--delete-data",
          "--record",
          "--json"
        ],
        "dryRun": "--dry-run",
        "confirm": "--yes"
      },
      "removes": [
        "signIn"
      ],
